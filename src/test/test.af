.needs <std>
.needs <test>

import {print} from "String" under str;
import string from "String";
import uni_string from "uni_string";
import unordered_map from "Collections/unordered_map";
import vector from "Collections/Vector";
import option from "Utils/option";
import {Some, None, optionWrapper} from "Utils/option" under opt;
import {accept, reject, resultWrapper} from "Utils/result" under res;
import Map from "Utils/Map";
import result from "Utils/result";
import {describe, it, assertEqual, assertTrue, fix, getFixture, assertFalse, beforeEach, afterEach, beforeAll, afterAll, itSkip, summary} from "ATest" under test;
import JSON from "JSON";
import { parse } from "JSON/Parse" under parser;
import {String, Number, Boolean, List, Object, Null, parse, parseAsync, stringifyAsync} from "JSON" under json;
import Box from "Memory";
import {wrap} from "Memory" under box;
import {async_thread} from "concurrency" under task;

class AsyncSchedulerProbe {
	mutable bool completed;

	fn init() -> Self {
		my.completed = false;
		return my;
	};
};

fn finishSchedulerProbe(const AsyncSchedulerProbe probe) -> int {
	sleep(0, 100000000);
	probe.completed = true;
	return 1;
};

fn sumFive(const int a, const int b, const int c, const int d,
		const int e) -> int {
	return a + b + c + d + e;
};

fn stringifyFive(const int a, const int b, const int c, const int d,
		const int e) -> string {
	return `{a},{b},{c},{d},{e}`;
};

async fn runSchedulerProbe(const AsyncSchedulerProbe probe) -> int {
	return await task.async_thread::<int>(finishSchedulerProbe, probe);
};

async fn schedulerMarker() -> int {
	return 1;
};

unique class AsyncRunValue {
	int value = value;

	fn init(const int value) -> Self {
		return my;
	};
};

union Value {
	Float(float)
};

fn echoFloat(const float value) -> float {
	return value;
};

fn addFloats(const float left, const float right) -> float {
	return left + right;
};

async fn makeAsyncRunValue(const int value) -> AsyncRunValue! {
	return new AsyncRunValue(value);
};

class HookState {
	mutable bool beforeAllRan;
	mutable int beforeEachCount;
	mutable int afterEachCount;
	mutable bool afterAllRan;

	fn init() -> Self {
		my.reset();
		return my;
	};

	fn reset() -> void {
		my.beforeAllRan = false;
		my.beforeEachCount = 0;
		my.afterEachCount = 0;
		my.afterAllRan = false;
	};
};

shared class VectorAllocationShape {
  int value = value;
  fn init(const int value) -> Self { return my; };
};
mutable int vectorPayloadDrops = 0;
unique class VectorOwnedPayload {
  int value = value;
  fn init(const int value) -> Self { return my; };
  fn del() -> void { vectorPayloadDrops = vectorPayloadDrops + 1; };
};
unique class VectorCopiedPayload {
  int value = value;
  fn init(const int value) -> Self { return my; };
  fn __copy__() -> Self { return new VectorCopiedPayload(my.value); };
  fn del() -> void { vectorPayloadDrops = vectorPayloadDrops + 1; };
};
fn vectorCopiedMatches(const VectorCopiedPayload value, const adr args) -> bool {
  return value.value == 40;
};
fn vectorOwnedMatches(const VectorOwnedPayload value, const adr args) -> bool {
  return value.value == 20;
};
fn checkVectorOwnedPayload() -> int {
  const let values = new vector::<VectorOwnedPayload>(3);
  values.push_back(new VectorOwnedPayload(10));
  values.push_back(new VectorOwnedPayload(20));
  values.push_back(new VectorOwnedPayload(30));
  const long before = af_total_allocations();
  if values.get(0).unwrap().value != 10 { return 21; };
  if values.findFirst(vectorOwnedMatches).unwrap().value != 20 { return 29; };
  if af_total_allocations() != before { return 22; };
  const local let last = values.pop_back();
  const local let first = values.pop_front();
  if first.unwrap().value != 10 { return 23; };
  if last.unwrap().value != 30 { return 24; };
  if values.front().unwrap().value != 20 { return 25; };
  const let copies = new vector::<VectorCopiedPayload>(1);
  copies.push_back(new VectorCopiedPayload(40));
  const local let copied = copies.get(0);
  if copied.unwrap().value != 40 { return 26; };
  const long beforeFind = af_total_allocations();
  const local let found = copies.findFirst(vectorCopiedMatches);
  if found.unwrap().value != 40 { return 30; };
  if af_total_allocations() != beforeFind + #1 { return 31; };
  return 0;
};
fn vectorShapeGreater(const VectorAllocationShape left, const VectorAllocationShape right) -> bool {
  return left.value > right.value;
};
fn checkVectorSortAllocations() -> int {
  const let shapes = new vector::<VectorAllocationShape>(3);
  const let first = VectorAllocationShape(3);
  const let second = VectorAllocationShape(2);
  const let third = VectorAllocationShape(1);
  shapes.push_back(first); shapes.push_back(second); shapes.push_back(third);
  const long before = af_total_allocations();
  shapes.sort(vectorShapeGreater);
  if af_total_allocations() != before + #1 { return 1; };
  if shapes.front().unwrap().value != 1 { return 2; };
  if shapes.back().unwrap().value != 3 { return 3; };
  return 0;
};
fn vectorAllocationMatches(const int value, const adr args) -> bool { return value == 3; };
fn checkVectorAllocations() -> int {
  const let values = new vector::<int>(4);
  values.push_back(1); values.push_back(2); values.push_back(3);
  const let shapes = new vector::<VectorAllocationShape>(2);
  const let shape = VectorAllocationShape(42);
  shapes.push_back(shape);
  const long before = af_total_allocations();
  for mutable int i = 0; i < 20; i = i + 1 {
    const local let got = values.get(1);
    if got.unwrap() != 2 { return 1; };
    if values.front().unwrap() != 1 { return 2; };
    if values.back().unwrap() != 3 { return 3; };
    if values(2).unwrap() != 3 { return 4; };
    if values.get(-1).isSome() { return 5; };
    if values.get(3).isSome() { return 6; };
    if values.findFirst(vectorAllocationMatches).unwrap() != 3 { return 7; };
    const local let borrowed = shapes.get(0);
    if borrowed.unwrap().value != 42 { return 8; };
    if shapes.get_unlocked(0).unwrap().value != 42 { return 9; };
    mutable int total = 0;
    foreach value in values { total = total + value; };
    if total != 6 { return 10; };
  };
  if values.pop_front().unwrap() != 1 { return 11; };
  if values.pop_back().unwrap() != 3 { return 12; };
  if values.pop_back().unwrap() != 2 { return 13; };
  if values.pop_back().isSome() { return 14; };
  if values.front().isSome() { return 15; };
  if values.back().isSome() { return 16; };
  if af_total_allocations() != before { return 17; };
  return 0;
};

fn main() -> int{
    test.describe("Vector allocations", fn () {
        test.it("keeps lookup, iteration, search, and pop options local", fn () {
            const int before = af_live_blocks();
            const int status = checkVectorAllocations();
            const int after = af_live_blocks();
            test.assertEqual(0, status);
            test.assertEqual(before, after);
        });
        test.it("cleans owned and copied payloads in local options", fn () {
            const int before = af_live_blocks();
            vectorPayloadDrops = 0;
            const int status = checkVectorOwnedPayload();
            const int after = af_live_blocks();
            test.assertEqual(0, status);
            test.assertEqual(6, vectorPayloadDrops);
            test.assertEqual(before, after);
        });
        test.it("reuses a single scratch allocation while sorting objects", fn () {
            test.assertEqual(0, checkVectorSortAllocations());
        });
    });
	test.describe("Union", fn () {
		test.it("should preserve float payloads", fn () {
			let value = new Value->Float(3.5);

			match value {
				Float(actual) => {
					test.assertTrue(actual == 3.5);
				}
			};
		});
	});

	test.describe("Float calls", fn () {
		test.it("should preserve arguments and return values", fn () {
			const let actual = echoFloat(addFloats(1.25, 2.25));
			test.assertTrue(actual == 3.5);
		});
	});

	test.describe("String", fn () {
        test.it("should interpolate zero", fn () {
            uni_string value = `{0}`;
            test.assertTrue(value == "0");
        });

        test.it("should get the length of a string", fn () {
            string s = "Hello, World!";
            test.assertEqual(s.len(), 13);
        });

        test.it("should compare two strings", fn () {
            string s1 = "Hello";
            string s2 = "Hello";
            test.assertTrue(s1 == s2);
        });

        test.it("should push a character", fn () {
            string s = new string("abc");
            const let r = s.push('d');
            // test.assertEqual(r.len(), 4);
            test.assertTrue(r == "abcd");
        });

        test.it("should grow uni_string appends", fn () {
            const uni_string value = "";
            for int i = 0; i < 10000; i++ {
                value.push_in_place('x');
            };
            test.assertEqual(value.len(), 10000);
            test.assertTrue(value.at(0) == 'x');
            test.assertTrue(value.at(9999) == 'x');
        });

        test.it("should convert to upper and lower", fn () {
            string s = "AfLaT";
            test.assertTrue(s.toLower() == "aflat");
            test.assertTrue(s.toUpper() == "AFLAT");
        });

        test.it("should parse numeric strings", fn () {
            string s = new string("42");
            test.assertTrue(s.isNumeric());
            const let r = s.toInt();
            match r {
                Ok(val) => test.assertEqual(val, 42),
                Err() => test.assertTrue(false)
            };
        });
        
        test.it("should replace characters", fn () {
            string s = "foo bar";
            test.assertTrue(s.replaceChar(' ', '_') == "foo_bar");
        });

        test.it("should replace substrings", fn () {
            string s = "foo foo";
            test.assertTrue(s.replace("foo", "bar") == "bar bar");
        });

        test.it("should leave strings unchanged when the substring is missing", fn () {
            string s = "alpha";
            test.assertTrue(s.replace("z", "") == "alpha");
        });

        test.it("should ignore empty substrings", fn () {
            string s = "beta";
            test.assertTrue(s.replace(new string(""), "x") == "beta");
        });

        test.it("should create substrings", fn () {
            string s = "hello";
            test.assertTrue(s.subString(1, 4) == "ell");
        });

        return true;
    });

    test.describe("JSON", fn ( ) {
        test.fix("object", fn () {
            let obj = json.Object({
                "name": box.wrap(json.String("John")),
                "age": box.wrap(json.Number(30)),
            });
            return obj;
        });

        test.it("should stringify a JSON object", fn () {
            const JSON obj = test.getFixture("object");
            const let jsonString = obj.stringify();
            test.assertTrue(new string("{\"name\":\"John\",\"age\":30}") == jsonString);
            test.assertTrue(jsonString == obj.stringify(0));
        });

        test.it("should escape JSON strings", fn () {
            const char slash = '\\';
            const uni_string raw = "quote: ";
            raw.push_in_place('"');
            raw.append_raw(" slash: ");
            raw.push_in_place(slash);
            raw.push_in_place('\t');
            raw.push_in_place('\n');

            const uni_string expected = "";
            expected.push_in_place('"');
            expected.append_raw("quote: ");
            expected.push_in_place(slash);
            expected.push_in_place('"');
            expected.append_raw(" slash: ");
            expected.push_in_place(slash);
            expected.push_in_place(slash);
            expected.push_in_place(slash);
            expected.push_in_place('t');
            expected.push_in_place(slash);
            expected.push_in_place('n');
            expected.push_in_place('"');

            const JSON value = json.String(raw.cstr());
            test.assertTrue(value.stringify() == expected.to_string());
        });

        test.it("should pretty print nested JSON", fn () {
            const let inner = new vector::<Box::<JSON>>();
            inner.push_back(box.wrap(json.Boolean(true)));
            const let outer = new vector::<Box::<JSON>>();
            outer.push_back(box.wrap(json.Number(1)));
            outer.push_back(box.wrap(json.List($inner)));
            const JSON value = json.List($outer);
            test.assertTrue(value.stringify(1) == "[\n  1,\n  [\n    true\n  ]\n]");
        });

        test.it("should get a field from a JSON object", fn () {
            const JSON obj = test.getFixture("object");
            match obj.get("name") {
                Some(value) => match value.asString() {
                    Ok(s) => test.assertTrue(`John` == s),
                    Err(e) => test.assertEqual(`String`, `Error: {e}`)
                },
                None => test.assertEqual("String", "None")
            }
        });

        test.it("should input a field to a JSON object", fn () {
            JSON obj = test.getFixture("object");
            match obj.set("city", json.String("New York")) {
                Ok(o) => {},
                Err(e) => test.assertEqual(`Object`, `Error: {e}`)
            };

            match obj.get("city") {
                Some(value) => match value.asString() {
                    Ok(s) => test.assertTrue(`New York` == s),
                    Err(e) => test.assertEqual(`String`, `Error: {e}`)
                },
                None => test.assertEqual("String", "None")
            };
        });

        test.describe("json parse", fn () {
            test.it("should parse a JSON string", fn () {
                const string jsonString = new string("\"test\"");
                match json.parse(jsonString) {
                    Ok(value) => {
                        match value.asString() {
                            Ok(s) => {
                                test.assertTrue(`{s}` == `test`);
                            },
                            Err(e) => test.assertEqual(`String`, `Error: {e}`)
                        };
                    },
                    Err(e) => test.assertEqual(`String`, `Error: {e}`)
                };
            });

            test.it("should parse a JSON number", fn () {
                const let jsonString = "42";
                match json.parse(jsonString) {
                    Ok(value) => {
                        match value.asNumber() {
                            Ok(n) => test.assertEqual(n, 42),
                            Err(e) => test.assertEqual(`Number`, `Error: {e}`)
                        };
                    },
                    Err(e) => test.assertEqual(`Number`, `Error: {e}`)
                };
            });

            test.it("should parse a JSON boolean true", fn () {
                const let jsonString = "true";
                match json.parse(jsonString) {
                    Ok(value) => {
                        match value.asBoolean() {
                            Ok(b) => test.assertTrue(b),
                            Err(e) => test.assertEqual(`Boolean`, `Error: {e}`)
                        };
                    },
                    Err(e) => test.assertEqual(`Boolean`, `Error: {e}`)
                };
            });

            test.it("should parse an empty JSON list", fn () {
                const string jsonString = "[]";
                match json.parse(jsonString) {
                    Ok(value) => match value.asList() {
                        Ok(list) => test.assertEqual(list.count(), 0),
                        Err(e) => test.assertEqual(`List`, `Error: {e}`)
                    },
                    Err(e) => test.assertEqual(`List`, `Error: {e}`)
                };
            });

            test.it("should parse JSON asynchronously", fn () {
                const string jsonString = "{\"ready\":true}";
                match run json.parseAsync(jsonString) {
                    Ok(value) => match value.get("ready") {
                        Some(ready) => match ready.asBoolean() {
                            Ok(flag) => test.assertTrue(flag),
                            Err(e) => test.assertEqual(`Boolean`, `Error: {e}`)
                        },
                        None => test.assertTrue(false)
                    },
                    Err(e) => test.assertEqual(`Object`, `Error: {e}`)
                };
            });

            test.it("should repeatedly run tasks returning unique results", fn () {
                mutable bool valid = true;
                for int index = 0; index < 100; index++ {
                    let value = (run makeAsyncRunValue(index))!;
                    if value.value != index {
                        valid = false;
                    };
                };
                test.assertTrue(valid);
            });

            test.it("should keep the scheduler free during background CPU work", fn () {
                const AsyncSchedulerProbe probe = new AsyncSchedulerProbe();
                const let pending = runSchedulerProbe(probe);
                detach pending;
                sleep(0, 10000000);
                const int marker = run schedulerMarker();
                const bool schedulerProgressed = probe.completed == false;
                sleep(0, 150000000);
                test.assertTrue(schedulerProgressed);
                test.assertTrue(probe.completed);
                test.assertEqual(marker, 1);
            });

            test.it("should await an already-spawned task without resuming it early", fn () {
                const AsyncSchedulerProbe probe = new AsyncSchedulerProbe();
                const let pending = runSchedulerProbe(probe);
                spawn pending;
                sleep(0, 10000000);
                const int value = run pending;
                test.assertTrue(probe.completed);
                test.assertEqual(value, 1);
            });

            test.it("should run generic background functions with five arguments", fn () {
                const int total = run task.async_thread::<int>(
                    sumFive, 1, 2, 3, 4, 5);
                test.assertEqual(total, 15);

                const string joined = run task.async_thread::<string>(
                    stringifyFive, 1, 2, 3, 4, 5);
                test.assertTrue(joined == "1,2,3,4,5");
            });

            test.it("should safely cancel background CPU work", fn () {
                const AsyncSchedulerProbe probe = new AsyncSchedulerProbe();
                const let pending = runSchedulerProbe(probe);
                spawn pending;
                sleep(0, 10000000);
                cancel pending;
                sleep(0, 150000000);
                test.assertTrue(probe.completed);
            });

            test.it("should preserve parse errors asynchronously", fn () {
                const string jsonString = "{";
                match run json.parseAsync(jsonString) {
                    Ok(__value) => test.assertTrue(false),
                    Err(__error) => test.assertTrue(true)
                };
            });

            test.it("should serialize JSON asynchronously", fn () {
                const JSON value = json.String("async");
                const string compact = run value.stringifyAsync();
                test.assertTrue(compact == "\"async\"");

                const let values = new vector::<Box::<JSON>>();
                values.push_back(box.wrap(json.Number(7)));
                const JSON list = json.List($values);
                const string pretty = run json.stringifyAsync(list, 1);
                test.assertTrue(pretty == "[\n  7\n]");
                const string memberPretty = run list.stringifyPrettyAsync(1);
                test.assertTrue(memberPretty == pretty);
            });
            
            test.describe("JSON.parse", fn () {
                test.it("should parse directly from a string", fn () {
                    const string jsonString = "\"direct\"";
                    match json.parse(jsonString) {
                        Ok(value) => match value.asString() {
                            Ok(s) => test.assertTrue(`{s}` == "direct"),
                            Err(e) => test.assertEqual(`String`, `Error: {e}`)
                        },
                        Err(e) => test.assertEqual(`String`, `Error: {e}`)
                    };
                });

                test.it("should parse nested objects via JSON.parse", fn () {
                    const string jsonString = "{ \"items\": [1, 2], \"enabled\": true }";
                    match json.parse(jsonString) {
                        Ok(value) => match value.asObject() {
                            Ok(map) => {
                                match map.get("enabled") {
                                    Some(v) => match v.get().asBoolean() {
                                        Ok(flag) => test.assertTrue(flag),
                                        Err(e) => test.assertEqual(`Boolean`, `Error: {e}`)
                                    },
                                    None => test.assertTrue(false)
                                };
                                match map.get("items") {
                                    Some(v) => match v.get().asList() {
                                        Ok(list) => test.assertEqual(list.count(), 2),
                                        Err(e) => test.assertEqual(`List`, `Error: {e}`)
                                    },
                                    None => test.assertTrue(false)
                                };
                            },
                            Err(e) => test.assertEqual(`Object`, `Error: {e}`)
                        },
                        Err(e) => test.assertEqual(`Object`, `Error: {e}`)
                    };
                });
            });
        });
    });

    test.fix("hookState", fn () {
        return new HookState();
    });

    test.describe("ATest hooks", fn () {
        test.beforeAll(fn () {
            HookState state = test.getFixture("hookState");
            state.beforeAllRan = true;
        });

        test.beforeEach(fn () {
            HookState state = test.getFixture("hookState");
            state.beforeEachCount = state.beforeEachCount + 1;
        });

        test.afterEach(fn () {
            HookState state = test.getFixture("hookState");
            state.afterEachCount = state.afterEachCount + 1;
        });

        test.afterAll(fn () {
            HookState state = test.getFixture("hookState");
            state.afterAllRan = true;
        });

        test.it("should run before hooks once", fn () {
            HookState state = test.getFixture("hookState");
            test.assertTrue(state.beforeAllRan);
            test.assertEqual(state.beforeEachCount, 1);
            test.assertEqual(state.afterEachCount, 0);
        });

        test.itSkip("should skip remaining tests", "demonstration");
    });

    test.describe("ATest hook verification", fn () {
        test.it("should run afterAll hook", fn () {
            HookState state = test.getFixture("hookState");
            test.assertTrue(state.afterAllRan);
        });
    });

    test.summary();
};
