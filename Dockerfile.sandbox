# ---- builder ----
FROM ubuntu:22.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libboost-dev \
    bash \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV AFLAT_ROOT=/opt/aflat
COPY CMakeLists.txt ${AFLAT_ROOT}/
COPY src ${AFLAT_ROOT}/src

RUN cmake -S ${AFLAT_ROOT} -B ${AFLAT_ROOT}/build -DCMAKE_BUILD_TYPE=Release \
        -DAFLAT_NATIVE_BUILD=OFF \
    && cmake --build ${AFLAT_ROOT}/build --target aflat --parallel "$(nproc)"

COPY libraries ${AFLAT_ROOT}/libraries
COPY rebuild-libs.sh ${AFLAT_ROOT}/
RUN cd ${AFLAT_ROOT} && bash rebuild-libs.sh -j "$(nproc)"

# ---- runtime ----
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    bash \
    && rm -rf /var/lib/apt/lists/*

ENV AFLAT_ROOT=/opt/aflat
COPY --from=builder ${AFLAT_ROOT}/bin ${AFLAT_ROOT}/bin
COPY --from=builder ${AFLAT_ROOT}/libraries ${AFLAT_ROOT}/libraries

ENV PATH=${AFLAT_ROOT}/bin:$PATH
ENV AFLAT_PORTABLE_OUTPUT=1
WORKDIR /workspace

ENTRYPOINT ["/bin/sh"]
CMD ["-c", "aflat --help; code=$?; [ \"$code\" -eq 0 ] || [ \"$code\" -eq 1 ]"]
