.needs <std>

import {print} from "uni_string" under uni;
import uni_string from "uni_string";
import Argument, CommandLineArgs from "CLArgs";
import FileHandle from "files";
import {renameFile, removeFile} from "files" under fs;
import Formatter from "./Formatter";


fn getTextFromFile(uni_string &&path) -> uni_string! {
    const let handle = new FileHandle($path);
    let file = $handle.open()!;
    const let input = file.get()!;
    const let readText = input.readToEnd()!;
    const let text = new uni_string(readText.cstr());
    return text;
};

fn writeTextToFile(uni_string &&path, uni_string contents) -> bool! {
    // Read the original's permissions first: the formatted text replaces
    // the file by rename, which swaps in a new inode, so the mode has to
    // be carried onto the replacement explicitly. Opening the original
    // read/write also keeps the old behavior of failing on files the
    // user cannot write.
    const let sourceHandle = new FileHandle(new uni_string(path.cstr()));
    let source = $sourceHandle.open()!;
    const int mode = source.get()!.mode()!;

    // Write the formatted text to a sibling temp file, then rename it
    // over the original. The original is never opened for writing, so
    // until the rename lands its bytes are untouched: a failed or
    // interrupted write cannot destroy it.
    const let tempPath = path.concat(new uni_string(".afmt.tmp"));
    const let tempHandle = new FileHandle(new uni_string(tempPath.cstr()));
    let temp = $tempHandle.create()!;
    const let out = temp.get()!;
    out.setMode(mode);

    // A single sys_write is not a completion guarantee; loop until the
    // whole buffer is out.
    mutable int offset = 0;
    while offset < contents.len() {
        const int written = out.write(contents.cstr() + offset);
        if written <= 0 {
            match fs.removeFile(tempPath.cstr()) {
                Ok(_) => {},
                Err(_) => {}
            };
            return false;
        };
        offset = offset + written;
    };

    if out.sync() < 0 {
        match fs.removeFile(tempPath.cstr()) {
            Ok(_) => {},
            Err(_) => {}
        };
        return false;
    };

    const bool renamed = fs.renameFile(tempPath.cstr(), path.cstr())!;
    return renamed;
};

fn main(int argc, adr argv) -> int {
    const let args = new CommandLineArgs(argc, argv);

    args.with_arguments([
        new Argument("help", "h", "Display help", "false", true),
        new Argument("inplace", "i", "Overwrite the input file with formatted output", "false", true)
    ]);

    match args.parse() {
        Ok(_) => {},
        Err(error) => {
            uni.print(`Invalid arguments: {error}\n`);
            return 1;
        }
    };

    if args.hasTag("help") {
        args.printHelp();
        return 0;
    };


    let path = match args.popCommandRaw() {
        Ok(value) => resolve value,
        Err(_) => {
            uni.print("Usage: afmt [--inplace|-i] <file.af>\n");
            return 1;
        }
    };



    let contents = getTextFromFile(new uni_string(path)).expect("Failed to read from file");

    const let formatter = Formatter($contents);
    const let formatted = formatter.format();

    if args.hasTag("inplace") {
        match writeTextToFile(new uni_string(path), formatted) {
            Ok(written) => {
                if !written {
                    uni.print("Failed to write the complete formatted file\n");
                    return 1;
                };
            },
            Err(error) => {
                uni.print(`Failed to write file: {error}\n`);
                return 1;
            }
        };
    } else {
        uni.print(formatted);
    };

    return 0;
};
