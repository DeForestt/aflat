.needs <std>
import unordered_map from "Collections/unordered_map";

fn mapOnly() -> void {
    let map = new unordered_map::<adr, int>();
    map.set("one", 1); map.set("two", 2); map.set("one", 3);
    assert(map.count() == 2, "map count");
    assert(map.get("one").unwrap() == 3, "map replace");
    const let keys = map.keys(); assert(keys.count() == 2, "map keys");
    mutable int sum = 0;
    const let guard = map.iterationGuard();
    foreach entry in map { sum = sum + entry.value; };
    delete guard;
    assert(sum == 5, "map iteration");
    map.clear(); assert(map.count() == 0, "map clear");
    map.set("again", 4); assert(map.get("again").unwrap() == 4, "map reuse");
    delete map;
};

fn main() -> int {
    mapOnly();
    return 0;
};
