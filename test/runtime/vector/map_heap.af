.needs <std>
import unordered_map from "Collections/unordered_map";

fn main() -> int {
    let map = new unordered_map::<adr, int>();
    map.set("one", 1); map.set("two", 2);
    map.clear();
    map.set("six", 6); assert(map.get("six").unwrap() == 6, "short key reuse");
    delete map;
    return 0;
};
