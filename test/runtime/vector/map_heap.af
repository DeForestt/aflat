.needs <std>
import unordered_map from "Collections/unordered_map";

fn check(const adr key, const int value) -> int {
    let map = new unordered_map::<adr, int>();
    map.set(key, value);
    const let got = map.get(key);
    if got.isNone() { delete map; return 1; };
    if got.unwrap() != value { delete map; return 2; };
    delete map;
    return 0;
};

fn main() -> int {
    if check("one", 100) != 0 { return 1; };
    if check("two", 101) != 0 { return 2; };
    if check("six", 102) != 0 { return 3; };
    if check("again", 103) != 0 { return 4; };
    if check("three", 104) != 0 { return 5; };
    if check("four", 105) != 0 { return 6; };
    if check("five", 106) != 0 { return 7; };
    if check("seven", 107) != 0 { return 8; };
    if check("hello", 108) != 0 { return 9; };
    if check("a", 109) != 0 { return 10; };
    if check("ab", 110) != 0 { return 11; };
    if check("abcd", 111) != 0 { return 12; };
    if check("abcde", 112) != 0 { return 13; };
    if check("key", 113) != 0 { return 14; };
    if check("value", 114) != 0 { return 15; };
    if check("test", 115) != 0 { return 16; };
    return 0;
};
