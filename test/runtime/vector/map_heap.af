.needs <std>
import unordered_map from "Collections/unordered_map";

fn main() -> int {
    let map = new unordered_map::<adr, int>();
    map.set("again", 4); map.set("two", 2);
    assert(map.get("again").unwrap() == 4, "again with two present");
    assert(map.get("two").unwrap() == 2, "two with again present");
    delete map;
    return 0;
};
