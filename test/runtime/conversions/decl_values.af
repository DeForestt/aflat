.needs <std>
import vector from "Collections/Vector";
import uni_string from "uni_string";
import {str_comp} from "strings" under strings;

fn check(const bool cond, const adr label) -> void {
    assert(cond, label);
};

fn checkText(const uni_string actual, const adr expected,
             const adr label) -> void {
    assert(strings.str_comp(actual.cstr(), expected) == 1, label);
};

fn main() -> int {
    // Signed widening preserves negative values (declarations).
    const i8 a8 = -128;
    const i16 a8to16 = a8;
    check(a8to16 == -128, "decl i8 min -> i16");
    const i32 a8to32 = a8;
    check(a8to32 == -128, "decl i8 min -> i32");
    const i64 a8to64 = a8;
    check(a8to64 == #-128, "decl i8 min -> i64");
    const isize a8toSize = a8;
    check(a8toSize == #-128, "decl i8 min -> isize");

    const i16 a16 = -30000;
    const i32 a16to32 = a16;
    check(a16to32 == -30000, "decl i16 -> i32");
    const i64 a16to64 = a16;
    check(a16to64 == #-30000, "decl i16 -> i64");

    const i32 negOne = -1;
    const i64 negOne64 = negOne;
    check(negOne64 == #-1, "decl i32 -1 -> i64");
    const i32 mn = -2147483647;
    const i32 i32min = mn - 1;
    const i64 i32min64 = i32min;
    check(i32min64 == #-2147483648, "decl i32 min -> i64");

    // The motivating shape: an int variable declared into a long.
    const int legacy = -5;
    const long legacyWide = legacy;
    check(legacyWide == #-5, "decl int -5 -> long");

    // Literal-led negatives arrive by construction, not register luck.
    const long ledLong = 0 - 5;
    check(ledLong == #-5, "decl 0 - 5 -> long");
    const i64 led64 = 0 - 5;
    check(led64 == #-5, "decl 0 - 5 -> i64");

    // Unsigned widening preserves values with the highest bit set.
    const u8 b8 = 255;
    const i16 b8to16 = b8;
    check(b8to16 == 255, "decl u8 max -> i16");
    const u16 b8toU16 = b8;
    check(b8toU16 == 255, "decl u8 max -> u16");
    const i64 b8to64 = b8;
    check(b8to64 == #255, "decl u8 max -> i64");
    const usize b8toSize = b8;
    check(b8toSize == 255, "decl u8 max -> usize");

    const u16 b16 = 65535;
    const i32 b16to32 = b16;
    check(b16to32 == 65535, "decl u16 max -> i32");
    const u64 b16to64 = b16;
    checkText(`v={b16to64}`, "v=65535", "decl u16 max -> u64");

    const u32 zero32 = 0;
    const u32 b32 = zero32 - 1;
    const i64 b32to64 = b32;
    check(b32to64 == #4294967295, "decl u32 max -> i64");
    const u64 b32toU64 = b32;
    checkText(`v={b32toU64}`, "v=4294967295", "decl u32 max -> u64");
    const usize b32toSize = b32;
    checkText(`v={b32toSize}`, "v=4294967295", "decl u32 max -> usize");

    const u64 zero64 = 0;
    const u64 b64 = zero64 - 1;
    const usize b64toSize = b64;
    checkText(`v={b64toSize}`, "v=18446744073709551615",
              "decl u64 max -> usize");

    // Range-identical pairs across names need no code but must work.
    const i64 wide = #-1234567890123456789;
    const isize wideAsSize = wide;
    check(wideAsSize == #-1234567890123456789, "decl i64 -> isize");
    const i64 backAgain = wideAsSize;
    check(backAgain == #-1234567890123456789, "decl isize -> i64");

    // Alias pairs.
    const short sh = -700;
    const int shToInt = sh;
    check(shToInt == -700, "decl short -> int");
    const byte by = 200;
    const u16 byTo16 = by;
    check(byTo16 == 200, "decl byte -> u16");
    const char ch = 'A';
    const i16 chTo16 = ch;
    check(chTo16 == 65, "decl char -> i16");

    // Values loaded from memory widen by the same rules.
    let values = new vector::<i16>(2);
    values.push_back(-30000);
    values.push_back(30000);
    const i16 loaded = values.get(0).unwrap();
    const i64 loadedWide = loaded;
    check(loadedWide == #-30000, "decl loaded i16 -> i64");
    let uvalues = new vector::<u16>(1);
    uvalues.push_back(65535);
    const u16 loadedU = uvalues.get(0).unwrap();
    const u32 loadedUWide = loadedU;
    check(loadedUWide == 65535, "decl loaded u16 -> u32");

    // adr sources declare into integer types under the legacy rules
    // (design section 2.2 carve-out), not the classifier.
    const adr p = af_malloc(64);
    const long pBits = p;
    check(pBits == p, "decl adr -> long keeps legacy rules");

    // Zero everywhere.
    const u8 z8 = 0;
    const u64 z8to64 = z8;
    check(z8to64 == 0, "decl u8 zero -> u64");
    const i32 zi = 0;
    const i64 ziWide = zi;
    check(ziWide == #0, "decl i32 zero -> i64");
    return 0;
};
