.needs <std>
import result from "Utils/result";
import {accept, reject, resultWrapper} from "Utils/result" under res;
import Error from "Utils/Error";
import string from "String";
import {print} from "io" under io;
import {str_comp} from "strings" under strings;

fn main() -> int {
    io.print("start\n");
    const i32 neg = -10;
    let r1 = neg as u32;
    io.print("r1 built\n");
    const bool e1 = r1.isErr();
    io.print("r1 isErr read\n");
    const adr rendered = r1.unwrapErr().render().cstr();
    io.print("r1 rendered\n");
    const int cmp = strings.str_comp(
        rendered,
        "Error: checked conversion failed: value -10 of type i32 is out of range for type u32 (range 0..4294967295)");
    io.print("r1 message compared\n");
    const i32 five = 5;
    let r2 = five as u32;
    io.print("r2 built\n");
    const bool ok2 = r2.isOk();
    io.print("r2 isOk read\n");
    const u32 v2 = r2.unwrap();
    io.print("r2 unwrapped\n");
    const i64 wide = #5000000000;
    let r3 = wide as i32;
    io.print("r3 built\n");
    const bool e3 = r3.isErr();
    io.print("r3 isErr read\n");
    const i64 small = #5;
    let r4 = small as i32;
    io.print("r4 built\n");
    const i32 v4 = r4.unwrap();
    io.print("r4 unwrapped\n");
    io.print("all done, returning\n");
    return 0;
};
