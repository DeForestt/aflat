.needs <std>
import uni_string from "uni_string";
import {_fUCstr} from "uni_string" under f;
import {str_comp} from "strings" under strings;

// Direct call to uni_string's _fUCstr with %c (a pre-existing
// specifier). 74 = rendered "v=A", 75 = not.
fn main() -> int {
    const uni_string out = f._fUCstr("v=%c", "A");
    if strings.str_comp(out.cstr(), "v=A") == 1 { return 74; };
    return 75;
};
