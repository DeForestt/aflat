.needs <std>

// Bug A oracle: short -30000 promoted into int arithmetic.
// 40 = correct (-30000), 41 = zero-extended (35536), 42 = anything else.
fn main() -> int {
    const short s = -30000;
    const int n = 0 + s;
    if n == -30000 { return 40; };
    if n == 35536 { return 41; };
    return 42;
};
