.needs <std>
import string from "String";
import uni_string from "uni_string";
import {str_comp} from "strings" under strings;

class Marker {
  fn init() -> Self { return my; };
  fn toString() -> uni_string { return `Marker`; };
};

fn checkUni(const uni_string actual, const adr expected, const adr label) -> void {
    assert(strings.str_comp(actual.cstr(), expected) == 1, label);
};

fn checkStr(const string actual, const adr expected, const adr label) -> void {
    assert(strings.str_comp(actual.cstr(), expected) == 1, label);
};

fn checkAdr(const adr actual, const adr expected, const adr label) -> void {
    assert(strings.str_comp(actual, expected) == 1, label);
};

// The same battery through the uni_string path (std _fUCstr) and the
// string path (String fString). Both must render every sized type as
// its numeric value.
fn checkSizedValues() -> void {
    const i8 i8min = -128;
    checkUni(`i8={i8min}`, "i8=-128", "uni i8 min");
    checkStr(`i8={i8min}`, "i8=-128", "string i8 min");
    const i8 i8max = 127;
    checkUni(`i8={i8max}`, "i8=127", "uni i8 max");
    checkStr(`i8={i8max}`, "i8=127", "string i8 max");
    const i8 i8zero = 0;
    checkUni(`i8={i8zero}`, "i8=0", "uni i8 zero");
    checkStr(`i8={i8zero}`, "i8=0", "string i8 zero");

    const i16 i16neg = -30000;
    checkUni(`i16={i16neg}`, "i16=-30000", "uni i16 neg");
    checkStr(`i16={i16neg}`, "i16=-30000", "string i16 neg");
    const i16 i16pos = 30000;
    checkUni(`i16={i16pos}`, "i16=30000", "uni i16 pos");
    checkStr(`i16={i16pos}`, "i16=30000", "string i16 pos");

    const i32 i32neg = -123456789;
    checkUni(`i32={i32neg}`, "i32=-123456789", "uni i32 neg");
    checkStr(`i32={i32neg}`, "i32=-123456789", "string i32 neg");

    const i64 i64pos = #1234567890123456789;
    const i64 i64neg = i64pos * -1;
    checkUni(`i64={i64neg}`, "i64=-1234567890123456789", "uni i64 neg");
    checkStr(`i64={i64neg}`, "i64=-1234567890123456789", "string i64 neg");
    checkUni(`i64={i64pos}`, "i64=1234567890123456789", "uni i64 pos");
    checkStr(`i64={i64pos}`, "i64=1234567890123456789", "string i64 pos");
    const i64 i64zero = #0;
    checkUni(`i64={i64zero}`, "i64=0", "uni i64 zero");
    checkStr(`i64={i64zero}`, "i64=0", "string i64 zero");

    const u8 u8max = 255;
    checkUni(`u8={u8max}`, "u8=255", "uni u8 max");
    checkStr(`u8={u8max}`, "u8=255", "string u8 max");

    const u16 u16max = 65535;
    checkUni(`u16={u16max}`, "u16=65535", "uni u16 max");
    checkStr(`u16={u16max}`, "u16=65535", "string u16 max");

    const u32 u32two = 2000000000;
    const u32 u32big = u32two + u32two;
    checkUni(`u32={u32big}`, "u32=4000000000", "uni u32 above int max");
    checkStr(`u32={u32big}`, "u32=4000000000", "string u32 above int max");
    const u32 u32zero = 0;
    checkUni(`u32={u32zero}`, "u32=0", "uni u32 zero");
    checkStr(`u32={u32zero}`, "u32=0", "string u32 zero");

    const u64 u64zero = 0;
    const u64 u64max = u64zero - 1;
    checkUni(`u64={u64max}`, "u64=18446744073709551615", "uni u64 max");
    checkStr(`u64={u64max}`, "u64=18446744073709551615", "string u64 max");
    const u64 u64base = 123456789;
    const u64 u64big = u64base * 1000000000 + 123456789;
    checkUni(`u64={u64big}`, "u64=123456789123456789", "uni u64 big");
    checkStr(`u64={u64big}`, "u64=123456789123456789", "string u64 big");
    checkUni(`u64={u64zero}`, "u64=0", "uni u64 zero");
    checkStr(`u64={u64zero}`, "u64=0", "string u64 zero");

    mutable isize isz = 9876543210;
    isz = isz * -1;
    checkUni(`isize={isz}`, "isize=-9876543210", "uni isize neg");
    checkStr(`isize={isz}`, "isize=-9876543210", "string isize neg");

    const usize usz = 12345678901;
    checkUni(`usize={usz}`, "usize=12345678901", "uni usize numeric");
    checkStr(`usize={usz}`, "usize=12345678901", "string usize numeric");

    const short sh = -30000;
    checkUni(`short={sh}`, "short=-30000", "uni short neg");
    checkStr(`short={sh}`, "short=-30000", "string short neg");

    const long lg = #987654321098765432;
    checkUni(`long={lg}`, "long=987654321098765432", "uni long pos");
    checkStr(`long={lg}`, "long=987654321098765432", "string long pos");

    const byte by = 200;
    checkUni(`byte={by}`, "byte=200", "uni byte");
    checkStr(`byte={by}`, "byte=200", "string byte");
};

// Mixed widths in a single format string: the args are packed at each
// argument's natural width, so a wrong read width anywhere misaligns
// every value after it.
fn checkMixed() -> void {
    const i8 a = -128;
    const i16 b = 30000;
    const u32 two = 2000000000;
    const u32 c = two + two;
    const i64 pos = #1234567890123456789;
    const i64 d = pos * -1;
    const u64 zero = 0;
    const u64 e = zero - 1;
    const u8 f = 255;
    const u16 g = 65535;
    mutable isize h = 9876543210;
    h = h * -1;
    const adr expected = "-128|30000|4000000000|-1234567890123456789|18446744073709551615|255|65535|-9876543210";
    checkUni(`{a}|{b}|{c}|{d}|{e}|{f}|{g}|{h}`, expected, "uni mixed widths");
    checkStr(`{a}|{b}|{c}|{d}|{e}|{f}|{g}|{h}`, expected, "string mixed widths");
    checkAdr(`{a}|{b}|{c}|{d}|{e}|{f}|{g}|{h}`, expected, "adr mixed widths");

    // Narrow values after a wide one must still be read at their own
    // offsets.
    const long wide = #5000000000;
    const byte tail8 = 7;
    const short tail16 = -9;
    const int tail32 = 11;
    const adr expected2 = "5000000000/7/-9/11";
    checkUni(`{wide}/{tail8}/{tail16}/{tail32}`, expected2, "uni narrow after wide");
    checkStr(`{wide}/{tail8}/{tail16}/{tail32}`, expected2, "string narrow after wide");
    checkAdr(`{wide}/{tail8}/{tail16}/{tail32}`, expected2, "adr narrow after wide");
};

// The adr path (_fCstr) shares String's fString; spot-check the wide
// types through it directly.
fn checkAdrPath() -> void {
    const i64 pos = #1234567890123456789;
    const i64 neg = pos * -1;
    checkAdr(`i64={neg}`, "i64=-1234567890123456789", "adr i64 neg");
    const u64 zero = 0;
    const u64 max = zero - 1;
    checkAdr(`u64={max}`, "u64=18446744073709551615", "adr u64 max");
    const usize usz = 12345678901;
    checkAdr(`usize={usz}`, "usize=12345678901", "adr usize numeric");
};

// Pre-existing formatting behavior must not change: int, char, adr,
// string, bool, float, class toString, and placeholder-free literals.
fn checkRegressions() -> void {
    const int i = -42;
    checkUni(`int={i}`, "int=-42", "uni int regression");
    checkStr(`int={i}`, "int=-42", "string int regression");
    checkAdr(`int={i}`, "int=-42", "adr int regression");

    const char ch = 'x';
    checkUni(`char={ch}`, "char=x", "uni char regression");
    checkStr(`char={ch}`, "char=x", "string char regression");
    checkAdr(`char={ch}`, "char=x", "adr char regression");

    const bool bt = true;
    const bool bf = false;
    checkUni(`bool={bt}`, "bool=true", "uni bool true regression");
    checkUni(`bool={bf}`, "bool=false", "uni bool false regression");
    checkStr(`bool={bt}`, "bool=true", "string bool regression");
    checkAdr(`bool={bt}`, "bool=true", "adr bool regression");

    mutable float f = 3.14;
    checkUni(`float={f}`, "float=3.140000", "uni float regression");
    checkStr(`float={f}`, "float=3.140000", "string float regression");
    checkAdr(`float={f}`, "float=3.140000", "adr float regression");

    const let s = new string("hello");
    checkUni(`str={s}`, "str=hello", "uni string regression");
    checkStr(`str={s}`, "str=hello", "string string regression");
    checkAdr(`str={s}`, "str=hello", "adr string regression");
    delete s;

    const adr p = "pointer";
    checkUni(`adr={p}`, "adr=pointer", "uni adr regression");
    checkStr(`adr={p}`, "adr=pointer", "string adr regression");
    checkAdr(`adr={p}`, "adr=pointer", "adr adr regression");

    const Marker m = new Marker();
    checkUni(`obj={m}`, "obj=Marker", "uni toString regression");
    checkStr(`obj={m}`, "obj=Marker", "string toString regression");
    checkAdr(`obj={m}`, "obj=Marker", "adr toString regression");
    delete m;

    checkUni(`plain`, "plain", "uni plain literal");
    checkUni(`lit={42}`, "lit=42", "uni number literal");
};

fn main() -> int {
    checkSizedValues();
    checkMixed();
    checkAdrPath();
    checkRegressions();
    return 0;
};
