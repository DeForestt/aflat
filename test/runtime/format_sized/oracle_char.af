.needs <std>
import uni_string from "uni_string";
import {str_comp} from "strings" under strings;

// Oracle: if i8 falls into the char path, `v={x}` for x = 65 renders "v=A".
fn main() -> int {
    const i8 x = 65;
    const uni_string rendered = `v={x}`;
    assert(strings.str_comp(rendered.cstr(), "v=A") == 1, "i8 as char");
    return 0;
};
