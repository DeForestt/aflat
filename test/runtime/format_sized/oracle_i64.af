.needs <std>
import uni_string from "uni_string";
import {str_comp} from "strings" under strings;

// Oracle probe: does an i64 format correctly through the uni path?
fn main() -> int {
    const i64 pos = #1234567890123456789;
    const i64 neg = pos * -1;
    const uni_string rendered = `v={neg}`;
    assert(strings.str_comp(rendered.cstr(), "v=-1234567890123456789") == 1, "oracle i64");
    return 0;
};
