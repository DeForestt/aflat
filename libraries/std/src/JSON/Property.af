.needs <std>
import JSON from "JSON";
import {Object} from "JSON" under json;
import vector from "Collections/Vector";
import unordered_map from "Collections/unordered_map";
import Box from "Memory";
import JsonProperty from "JSON/Property/Fields";

class JsonPropertyRef {
  private loan JsonProperty value = value;

  fn init(const JsonProperty value) -> Self {
    return my;
  };

  fn get() -> loan JsonProperty {
    return my.value;
  };
};

class JsonSerializable {
  contract {
    vector::<JsonPropertyRef> fields = [];
  };

  fn registerField(const JsonProperty field) -> Self {
    my.fields.push_back(new JsonPropertyRef(field));
    return my;
  };

  fn serialize() -> JSON {
    const let obj = json.Object(new unordered_map::<adr,Box::<JSON>>());
    foreach field in my.fields {
      const JsonProperty current = field.get();
      obj.set(current.key, current.serialize()).expect("failed to set JSON field");
    };
    return obj;
  };

  fn init() {
    return my;
  };
};
