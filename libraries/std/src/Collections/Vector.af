.needs <std>
import Result from "Utils/Result";
import string from "String";
import Error from "Utils/Error";
import option from "Utils/option";
import Map from "Utils/Map";
import {Some, None, optionWrapper} from "Utils/option" under opt;
import result from "Utils/result";
import {accept, reject, resultWrapper} from "Utils/result" under res;
import tuple from "Collections/Tuple";
import {make_tuple} from "Collections/Tuple";
import {print} from "String" under str;
import {printInt} from "io" under io;
import Lock, LockGuard from "concurrency";
import raw_buffer from "Collections/raw_buffer";

// Keep optional wrappers in caller-owned local storage. New vector operations
// should avoid per-element allocations unless the payload requires ownership.
types(T)
unique class vector {
    // Vector owns [0, count); raw_buffer owns only the backing allocation.
    private raw_buffer::<T> storage = NULL;
    private int size = 0;
    private int count = 0;
    private Lock mutex = new Lock();
    private int iteratorIndex = 0;

    fn init(*const int size) -> Self {
        if size == 0 {
            my.size = 1; 
        } else {
            my.size = size;
        };
        my.storage = new raw_buffer::<T>(my.size);
        return my;
    };

    // Called while the vector lock is held. Publish capacity only after success.
    private fn reserve(const int capacity) -> local result::<bool> {
        if capacity <= my.size { return res.accept(true); };
        const local result::<bool> grown = my.storage.grow(capacity);
        if grown.isOk() { my.size = capacity; };
        return $grown;
    };

    private fn make_room() -> local result::<bool> {
        if my.count < my.size { return res.accept(true); };
        const int maximum = 2147483647 / T;
        if my.size >= maximum {
            return res.reject::<bool>(new Error("Vector capacity exceeds byte-size limit"));
        };
        mutable int capacity = maximum;
        if my.size <= maximum / 2 { capacity = my.size * 2; };
        return my.reserve(capacity);
    };

    when (T is primitive)
    fn push_back(const T value) -> loan Self {
        const local LockGuard __guard = my.mutex.guard();
        my.make_room().expect("Failed to grow vector"$adr);
        when(T is adr)
        my.storage.write(my.count, ?value).unwrap();
        when(T is not adr)
        my.storage.write(my.count, value).unwrap();
        my.count = my.count + 1;
        return my;
    };

    when (T is primitive)
    sink fn push_back(const T value) -> Self {
        const local LockGuard __guard = my.mutex.guard();
        my.make_room().expect("Failed to grow vector"$adr);
        when(T is adr)
        my.storage.write(my.count, ?value).unwrap();
        when(T is not adr)
        my.storage.write(my.count, value).unwrap();
        my.count = my.count + 1;
        return my;
    };

    when (T is not primitive and T is unique)
    fn push_back(const T &&value) -> loan Self {
        const local LockGuard __guard = my.mutex.guard();
        my.make_room().expect("Failed to grow vector"$adr);
        my.storage.write(my.count, $value).unwrap();
        my.count = my.count + 1;
        return my;
    };

    when (T is not primitive and T is unique)
    sink fn push_back(const T &&value) -> Self {
        const local LockGuard __guard = my.mutex.guard();
        my.make_room().expect("Failed to grow vector"$adr);
        my.storage.write(my.count, $value).unwrap();
        my.count = my.count + 1;
        return my;
    };

    when (T is not primitive and T is not unique)
    fn push_back(const T value) -> loan Self {
        const local LockGuard __guard = my.mutex.guard();
        my.make_room().expect("Failed to grow vector"$adr);
        my.storage.write(my.count, value).unwrap();
        my.count = my.count + 1;
        return my;
    };

    when (T is not primitive and T is not unique)
    sink fn push_back(const T value) -> Self {
        const local LockGuard __guard = my.mutex.guard();
        my.make_room().expect("Failed to grow vector"$adr);
        my.storage.write(my.count, value).unwrap();
        my.count = my.count + 1;
        return my;
    };

    safe fn count() -> int {
        const local LockGuard __guard = my.mutex.guard();
        return my.count;
    };

    fn extend(const int capasity) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if capasity <= my.size {
            return res.reject::<bool>(new Error("New capacity must be greater than current capacity"));
        };
        const local result::<bool> grown = my.reserve(capasity);
        match $grown {
            Ok(value) => return res.accept(value),
            Err(&&err) => return res.reject::<bool>($err)
        };
    };

    when (T is primitive)
    fn front() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<T>();
        };
        return my.get(0);
    };

    when (T is not primitive and T is unique and T missing __copy__)
    fn front() -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<&T>();
        };
        return my.get(0);
    };

    when (T is not primitive and T is unique and T has __copy__)
    fn front() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<T>();
        };
        return my.get(0);
    };

    when (T is not primitive and T is not unique and T has __copy__)
    fn front() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<T>();
        };

        return my.get(0);
    };

    when (T is not primitive and T is not unique and T missing __copy__)
    fn front() -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<&T>();
        };

        return my.get(0);
    };

    when (T is primitive)
    fn back() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<T>();
        };
        return my.get(my.count - 1);
    };

    when (T is not primitive and T is unique and T missing __copy__)
    fn back() -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<&T>();
        };
        return my.get(my.count - 1);
    };

    when (T is not primitive and T is unique and T has __copy__)
    fn back() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<T>();
        };
        return my.get(my.count - 1);
    };

    when (T is not primitive and T is not unique and T has __copy__)
    fn back() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<T>();
        };

        return my.get(my.count - 1);
    };

    when (T is not primitive and T is not unique and T missing __copy__)
    fn back() -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 {
            delete __guard;
            return opt.None::<&T>();
        };

        return my.get(my.count - 1);
    };

    when (T is primitive)
    fn pop_back() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 { return opt.None::<T>(); };
        const local result::<T> taken = my.storage.take(my.count - 1);
        if taken.isErr() { panic("Failed to extract vector element"); };
        my.count = my.count - 1;
        match $taken {
            Ok(value) => return opt.Some::<T>(value),
            Err(_) => return opt.None::<T>()
        };
    };

    when (T is not primitive and T is not unique)
    fn pop_back() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 { return opt.None::<T>(); };
        const local result::<T> taken = my.storage.take(my.count - 1);
        if taken.isErr() { panic("Failed to extract vector element"); };
        my.count = my.count - 1;
        match $taken {
            Ok(&&value) => return option::<T>->Some($value),
            Err(_) => return opt.None::<T>()
        };
    };

    when (T is not primitive and T is unique)
    fn pop_back() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 { return opt.None::<T>(); };
        const local result::<T> taken = my.storage.take(my.count - 1);
        if taken.isErr() { panic("Failed to extract vector element"); };
        my.count = my.count - 1;
        match $taken {
            Ok(&&value) => return option::<T>->Some($value),
            Err(_) => return opt.None::<T>()
        };
    };

    when (T is primitive)
    fn pop_front() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 { return opt.None::<T>(); };
        const local result::<T> taken = my.storage.take(0);
        if taken.isErr() { panic("Failed to extract vector element"); };
        my.storage.relocate(1, 0, my.count - 1).unwrap();
        my.count = my.count - 1;
        match $taken {
            Ok(value) => return opt.Some::<T>(value),
            Err(_) => return opt.None::<T>()
        };
    };

    when (T is not primitive and T is not unique)
    fn pop_front() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 { return opt.None::<T>(); };
        const local result::<T> taken = my.storage.take(0);
        if taken.isErr() { panic("Failed to extract vector element"); };
        my.storage.relocate(1, 0, my.count - 1).unwrap();
        my.count = my.count - 1;
        match $taken {
            Ok(&&value) => return option::<T>->Some($value),
            Err(_) => return opt.None::<T>()
        };
    };

    when (T is not primitive and T is unique)
    fn pop_front() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if my.count == 0 { return opt.None::<T>(); };
        const local result::<T> taken = my.storage.take(0);
        if taken.isErr() { panic("Failed to extract vector element"); };
        my.storage.relocate(1, 0, my.count - 1).unwrap();
        my.count = my.count - 1;
        match $taken {
            Ok(&&value) => return option::<T>->Some($value),
            Err(_) => return opt.None::<T>()
        };
    };

    when (T is primitive)
    fn get(const int index) -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) { return opt.None::<T>(); };
        const local result::<T> value = my.storage.read(index);
        match $value {
            Ok(element) => return opt.Some::<T>(element),
            Err(_) => return opt.None::<T>()
        };
    };

    when (T is not primitive and T has __copy__)
    fn get(const int index) -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) { return opt.None::<T>(); };
        // Copy directly into the option; an owning intermediate result would
        // require another allocation to move its payload into the option.
        const local result::<&T> value = my.storage.borrow(index);
        return opt.Some::<T>(value.unwrap());
    };

    when (T is not primitive and T is unique and T missing __copy__)
    fn get(const int index) -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) { return opt.None::<&T>(); };
        const local result::<&T> value = my.storage.borrow(index);
        match value {
            Ok(element) => return opt.Some::<&T>(element),
            Err(_) => return opt.None::<&T>()
        };
    };

    when (T is not unique and T missing __copy__ and T is not primitive)
    fn get(const int index) -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) { return opt.None::<&T>(); };
        const local result::<&T> value = my.storage.borrow(index);
        match value {
            Ok(element) => return opt.Some::<&T>(element),
            Err(_) => return opt.None::<&T>()
        };
    };

    // Skip the vector lock for callers coordinating access; storage still locks.
    when (T is not unique and T missing __copy__ and T is not primitive)
    fn get_unlocked(const int index) -> local option::<&T> {
        if (index >= my.count) | (index < 0) { return opt.None::<&T>(); };
        const local result::<&T> value = my.storage.borrow(index);
        match value {
            Ok(element) => return opt.Some::<&T>(element),
            Err(_) => return opt.None::<&T>()
        };
    };

    when (T is primitive)
    fn _call(const int index) -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        return my.get(index);
    };

    when (T is not primitive and T is unique and T missing __copy__)
    fn _call(const int index) -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        return my.get(index);
    };

    when (T is not primitive and T is unique and T has __copy__)
    fn _call(const int index) -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        return my.get(index);
    };

    when (T is not primitive and T is not unique and T has __copy__)
    fn _call(const int index) -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        return my.get(index);
    };

    when (T is not primitive and T is not unique and T missing __copy__)
    fn _call(const int index) -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        return my.get(index);
    };

    when (T is primitive)
    fn next() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        const let val = my.get(my.iteratorIndex);
        my.iteratorIndex = my.iteratorIndex + 1;
        if my.iteratorIndex > my.count {
            my.iteratorIndex = 0; // Reset iterator index if it exceeds the count
        };
        return val;
    };

    when (T is not primitive and T is unique and T missing __copy__)
    fn next() -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        const let val = my.get(my.iteratorIndex);
        my.iteratorIndex = my.iteratorIndex + 1;
        if my.iteratorIndex > my.count {
            my.iteratorIndex = 0; // Reset iterator index if it exceeds the count
        };
        return val;
    };

    when (T is not primitive and T is unique and T has __copy__)
    fn next() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        const let val = my.get(my.iteratorIndex);
        my.iteratorIndex = my.iteratorIndex + 1;
        if my.iteratorIndex > my.count {
            my.iteratorIndex = 0; // Reset iterator index if it exceeds the count
        };
        return val;
    };

    when (T is not primitive and T is not unique and T has __copy__)
    fn next() -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        const let val = my.get(my.iteratorIndex);
        my.iteratorIndex = my.iteratorIndex + 1;
        if my.iteratorIndex > my.count {
            my.iteratorIndex = 0; // Reset iterator index if it exceeds the count
        };
        return val;
    };

    when (T is not primitive and T is not unique and T missing __copy__)
    fn next() -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        const let val = my.get(my.iteratorIndex);
        my.iteratorIndex = my.iteratorIndex + 1;
        if my.iteratorIndex > my.count {
            my.iteratorIndex = 0; // Reset iterator index if it exceeds the count
        };
        return val;
    };


    when (T is primitive)
    fn findFirst(const adr predicate, * const adr args) -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        for int i = 0; i < my.count; i = i + 1 {
            const local let candidate = my.get(i);
            const let val = candidate.unwrap();
            const bool brk = predicate(val, args);
            if brk == true {
                delete __guard;
                return candidate;
            };
        };
        return opt.None::<T>();
    };

    when (T is not primitive and T is unique and T missing __copy__)
    fn findFirst(const adr predicate, * const adr args) -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        for int i = 0; i < my.count; i = i + 1 {
            const local let candidate = my.get(i);
            const let val = candidate.unwrap();
            const bool brk = predicate(val, args);
            if brk == true {
                delete __guard;
                return candidate;
            };
        };
        return opt.None::<&T>();
    };

    when (T is not primitive and T is unique and T has __copy__)
    fn findFirst(const adr predicate, * const adr args) -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        for int i = 0; i < my.count; i = i + 1 {
            const local let candidate = my.get(i);
            const let val = candidate.unwrap();
            const bool brk = predicate(val, args);
            if brk == true {
                delete __guard;
                return candidate;
            };
        };
        return opt.None::<T>();
    };

    when (T is not primitive and T is not unique and T has __copy__)
    fn findFirst(const adr predicate, * const adr args) -> local option::<T> {
        const local LockGuard __guard = my.mutex.guard();
        for int i = 0; i < my.count; i = i + 1 {
            const local let candidate = my.get(i);
            const let val = candidate.unwrap();
            const bool brk = predicate(val, args);
            if brk == true {
                delete __guard;
                return candidate;
            };
        };
        return opt.None::<T>();
    };

    when (T is not primitive and T is not unique and T missing __copy__)
    fn findFirst(const adr predicate, * const adr args) -> local option::<&T> {
        const local LockGuard __guard = my.mutex.guard();
        for int i = 0; i < my.count; i = i + 1 {
            const local let candidate = my.get(i);
            const let val = candidate.unwrap();
            const bool brk = predicate(val, args);
            if brk == true {
                delete __guard;
                return candidate;
            };
        };
        return opt.None::<&T>();
    };

    when (T is not primitive and T is not unique or T is adr)
    fn set(const int index, const any value) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) {
            return res.reject::<bool>(new Error("Index out of bounds"));
        };
        my.storage.replace(index, value).unwrap();
        return res.accept(true);
    };

    when (T is not primitive and T is unique)
    fn set(const int index, const T &&value) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) {
            return res.reject::<bool>(new Error("Index out of bounds"));
        };
        my.storage.replace(index, $value).unwrap();
        return res.accept(true);
    };

    when (T is primitive and T is not adr)
    fn set(const int index, const T value) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) {
            return res.reject::<bool>(new Error("Index out of bounds"));
        };
        my.storage.replace(index, value).unwrap();
        return res.accept(true);
    };

    when (T is primitive)
    fn insert(const int index, const T value) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if (index > my.count) | (index < 0) {
            return res.reject::<bool>(new Error("Index out of bounds"));
        };
        const local result::<bool> grown = my.make_room();
        match $grown {
            Err(&&err) => return res.reject::<bool>($err),
            Ok(_) => {}
        };
        my.storage.relocate(index, index + 1, my.count - index).unwrap();
        when(T is adr)
        my.storage.write(index, ?value).unwrap();
        when(T is not adr)
        my.storage.write(index, value).unwrap();
        my.count = my.count + 1;
        return res.accept(true);
    };

    when (T is not primitive and T is not unique)
    fn insert(const int index, const T value) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if (index > my.count) | (index < 0) {
            return res.reject::<bool>(new Error("Index out of bounds"));
        };
        const local result::<bool> grown = my.make_room();
        match $grown {
            Err(&&err) => return res.reject::<bool>($err),
            Ok(_) => {}
        };
        my.storage.relocate(index, index + 1, my.count - index).unwrap();
        my.storage.write(index, value).unwrap();
        my.count = my.count + 1;
        return res.accept(true);
    };

    when (T is not primitive and T is unique)
    fn insert(const int index, const T &&value) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if (index > my.count) | (index < 0) {
            return res.reject::<bool>(new Error("Index out of bounds"));
        };
        const local result::<bool> grown = my.make_room();
        match $grown {
            Err(&&err) => return res.reject::<bool>($err),
            Ok(_) => {}
        };
        my.storage.relocate(index, index + 1, my.count - index).unwrap();
        my.storage.write(index, $value).unwrap();
        my.count = my.count + 1;
        return res.accept(true);
    };

    when (T is primitive)
    fn drop(const int index) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) {
            return res.reject::<bool>(new Error("Index out of bounds"));
        };
        my.storage.destroy(index).unwrap();
        my.storage.relocate(index + 1, index, my.count - index - 1).unwrap();
        my.count = my.count - 1;
        return res.accept(true);
    };

    when (T is not primitive and T is not unique)
    fn drop(const int index) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) {
            return res.reject::<bool>(new Error("Index out of bounds"));
        };
        my.storage.destroy(index).unwrap();
        my.storage.relocate(index + 1, index, my.count - index - 1).unwrap();
        my.count = my.count - 1;
        return res.accept(true);
    };

    when (T is not primitive and T is unique)
    fn drop(const int index) -> result::<bool> {
        const local LockGuard __guard = my.mutex.guard();
        if (index >= my.count) | (index < 0) {
            return res.reject::<bool>(new Error("Index out of bounds"));
        };
        my.storage.destroy(index).unwrap();
        my.storage.relocate(index + 1, index, my.count - index - 1).unwrap();
        my.count = my.count - 1;
        return res.accept(true);
    };

    // Capacity arithmetic and collection-level ownership remain vector policy.
    private fn reserve_append(const int additional) -> void {
        assert(additional <= (2147483647 / T) - my.count, "Vector capacity exceeds byte-size limit");
        my.reserve(my.count + additional).expect("Failed to grow vector"$adr);
    };

    when(T is primitive)
    private fn append_copy(immutable vector::<T> other, const int index) -> void {
        my.push_back(other.storage.read(index).unwrap());
    };

    when(T is not primitive and T is not unique)
    private fn append_copy(immutable vector::<T> other, const int index) -> void {
        my.push_back(other.storage.borrow(index).unwrap());
    };

    when(T is not primitive and T is unique and T has __copy__)
    private fn append_copy(immutable vector::<T> other, const int index) -> void {
        const local result::<T> copied = other.storage.read(index);
        match $copied {
            Ok(&&value) => { my.push_back($value); },
            Err(_) => { panic("Failed to copy vector element"); }
        };
    };

    when(T is primitive or T is not unique or T has __copy__)
    private fn stitch_copy_locked(immutable vector::<T> other) -> void {
        const int length = other.count;
        my.reserve_append(length);
        for mutable int i = 0; i < length; i = i + 1 {
            my.append_copy(other, i);
        };
    };

    // A borrowed source must not create a second owner of move-only elements.
    when(T is primitive or T is not unique or T has __copy__)
    fn stitch(immutable vector::<T> other) -> loan Self {
        const adr selfAddress = ?my.count;
        const adr otherAddress = ?other.count;
        if selfAddress < otherAddress {
            const local LockGuard __selfGuard = my.mutex.guard();
            const local LockGuard __otherGuard = other.mutex.guard();
            my.stitch_copy_locked(other);
        } else {
            const local LockGuard __otherGuard = other.mutex.guard();
            const local LockGuard __selfGuard = my.mutex.guard();
            my.stitch_copy_locked(other);
        };
        return my;
    };

    private fn stitch_move_locked(const vector::<T> other) -> void {
        my.reserve_append(other.count);
        other.storage.transfer_to(my.storage, 0, my.count, other.count).unwrap();
        my.count = my.count + other.count;
        // The consuming parameter will drop its buffer after the guards release.
        other.count = 0;
    };

    fn stitch(const vector::<T> &&other) -> loan Self {
        const adr selfAddress = ?my.count;
        const adr otherAddress = ?other.count;
        assert(selfAddress != otherAddress, "Cannot consume a vector into itself");
        if selfAddress < otherAddress {
            const local LockGuard __selfGuard = my.mutex.guard();
            const local LockGuard __otherGuard = other.mutex.guard();
            my.stitch_move_locked(other);
        } else {
            const local LockGuard __otherGuard = other.mutex.guard();
            const local LockGuard __selfGuard = my.mutex.guard();
            my.stitch_move_locked(other);
        };
        return my;
    };

    fn reset() -> loan Self {
        const local LockGuard __guard = my.mutex.guard();
        my.iteratorIndex = 0;
        return my;
    };

    when (T is not primitive and T missing toString)
    fn toString() -> string {
        const local LockGuard __guard = my.mutex.guard();
        return `{__typeName__}(size={my.size}, count={my.count})`;
    };


    when (T is not primitive and T has toString and T is not unique)
    fn toString() -> string {
        const local LockGuard __guard = my.mutex.guard();
        string buf = `{__typeName__}: [`;
        foreach v in my {
            const let renderedValue = v.toString();
            const string renderedSuffix = `{renderedValue},`;
            buf = buf + renderedSuffix;
        };
        return buf + "]";
    };


    when (T is not primitive and T has toString and T is unique)
    fn toString() -> string {
        const local LockGuard __guard = my.mutex.guard();
        string buf = `{__typeName__}: [`;
        foreach v in my {
            const let renderedValue = v.toString();
            const string renderedSuffix = `{renderedValue},`;
            buf = buf + renderedSuffix;
        };
        return buf + "]";
    };

    when (T is primitive)
    fn toString() -> string {
        const local LockGuard __guard = my.mutex.guard();
        string buf = `{__typeName__}: [`;
        foreach v in my {
            buf = `{buf}{v},`;
        };
        return `{buf}]`;
    };

    when (T is not primitive and T is unique)
    fn del() {
        for mutable int i = 0; i < my.count; i = i + 1 {
            my.storage.destroy(i).unwrap();
        };
        delete my.storage;
        delete my.mutex;
    };

    when (T is primitive or T is not unique)
    fn del() {
        delete my.storage;
        delete my.mutex;
    };

    when (T is not primitive)
    fn sort(const adr comparator) -> void {
        const local LockGuard __guard = my.mutex.guard();
        for mutable int i = 0; i < my.count - 1; i = i + 1 {
            for mutable int j = 0; j < my.count - i - 1; j = j + 1 {
                const local result::<&T> left = my.storage.borrow(j);
                const local result::<&T> right = my.storage.borrow(j + 1);
                const bool exchange = comparator(left.unwrap(), right.unwrap());
                delete left;
                delete right;
                if exchange { my.storage.swap(j, j + 1).unwrap(); };
            };
        };
    };

    when (T is adr)
    fn sort(const adr comparator) -> void {
        const local LockGuard __guard = my.mutex.guard();
        for mutable int i = 0; i < my.count - 1; i = i + 1 {
            for mutable int j = 0; j < my.count - i - 1; j = j + 1 {
                const adr left = my.storage.read(j).unwrap();
                const adr right = my.storage.read(j + 1).unwrap();
                // The adr comparator receives addresses containing pointer values.
                const bool exchange = comparator(?left, ?right);
                if exchange { my.storage.swap(j, j + 1).unwrap(); };
            };
        };
    };

    when (T is primitive and T is not adr)
    fn sort(const adr comparator) -> void {
        const local LockGuard __guard = my.mutex.guard();
        for mutable int i = 0; i < my.count - 1; i = i + 1 {
            for mutable int j = 0; j < my.count - i - 1; j = j + 1 {
                const T left = my.storage.read(j).unwrap();
                const T right = my.storage.read(j + 1).unwrap();
                const bool exchange = comparator(left, right);
                if exchange { my.storage.swap(j, j + 1).unwrap(); };
            };
        };
    };
};
