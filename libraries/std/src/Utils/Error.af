.needs <std>

import string from "String";
import Render from "Utils/Error/Render";
import Option from "Utils/Option";
import Map from "Utils/Map";
import {str_comp} from "strings" under strings;

unique pedantic class Error {
    contract {
        private mutable string _typeName = new string(__typeName__);
        private mutable adr _render = NULL;
        const adr data = NULL;
        private mutable string _message = NULL;
        private mutable bool _hasMessage = false;
    };


    public void setRender(const adr render) {
        if my._render != NULL
        panic("Render already set.");

        my._render = render;
    };

    private string stdErrorMessage() : Render {
        return `{my._typeName}: {my._message}`;
    };

    Error init(const string &&message) {
        my._hasMessage = true;
        my._message = $message;
        return my;
    };

    Error init(const adr message) {
        my._hasMessage = true;
        my._message = new string(message);
        return my;
    };

    Error init(const string message) {
        my._hasMessage = true;
        my._message = new string(message.cstr());
        return my;
    };

    // A concrete contract signer may have a different layout. Preserve its
    // public description in an independent Error before storing it inline.
    Error init(const string kind, const string &&rendered) {
        delete my._typeName;
        my._typeName = new string(kind.cstr());
        my._hasMessage = true;
        my._message = $rendered;
        my._render = NULL;
        return my;
    };

    public fn snapshot() -> Error {
        return new Error(my._typeName, my.render());
    };

    public string render() {
        if my._render == NULL {
            if my._hasMessage { return new string(my._message.cstr()); };
            return `Error: {my._typeName}`;
        };
        return my._render();
    };

    public bool is(const adr type) {
        return strings.str_comp(my._typeName.cstr(), type) == 1;
    };

    public bool is(const string type) {
        return my._typeName == type;
    };

    public string toString() {
        return my.render();
    };

    public fn kind() -> loan string {
        return my._typeName;
    };

    public any match(const Map cases, *const any arg1, *const any arg2, *const any arg3, *const any arg4) {
        if cases.has(my._typeName.cstr()) {
            const adr foo = cases.get(my._typeName.cstr()).orElse(
            fn () return panic("No case for error type")
            );
            return foo(my, arg1, arg2, arg3, arg4);
        } else {
            const adr foo = cases.get("_").orElse(
            fn () return panic("No \"_\" case in match")
            );
            return foo(my, arg1, arg2, arg3, arg4);
        };
    };
};
