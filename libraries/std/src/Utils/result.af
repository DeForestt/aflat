.needs <std>
import string from "String";
import option from "Utils/option";
import Error from "Utils/Error";
import uni_string from "uni_string";


types(T)
/**
 * Result type that carries either `Ok(T)` success values or `Err(Error)`
 * failures, closely mirroring Rust's Result ergonomics.
 */
unique union result {
    Ok(T),
    Err(Error)

    when (T is primitive)
    safe fn expect(const string msg) -> loan T {
        match my {
            Ok(value) => return value,
            Err(err) => {
              panic(msg.cstr());
            }
        };
    };

    when (T is not primitive)
    safe fn expect(const string msg) -> loan T {
        match my {
            Ok(value) => return value,
            Err(err) => {
              panic(msg.cstr());
            }
        };
    };

    when (T is not primitive)
    safe sink fn expect(const string msg) -> T {
        match my {
            Ok(&&value) => return $value,
            Err(err) => {
              panic(msg.cstr());
            }
        };
    };

    when (T is primitive)
    safe fn expect(const adr msg) -> loan T {
        match my {
            Ok(value) => return value,
            Err(err) => {
              panic(msg);
            }
        };
    };

    when (T is not primitive)
    safe fn expect(const adr msg) -> loan T {
        match my {
            Ok(value) => return value,
            Err(err) => {
              panic(msg);
            }
        };
    };

    when (T is not primitive)
    safe sink fn expect(const adr msg) -> T {
        match my {
            Ok(&&value) => return $value,
            Err(err) => {
              panic(msg);
            }
        };
    };

    when (T is primitive)
    safe fn unwrap() -> loan T {
        match my {
            Ok(value) => return value,
            Err(err) => {
              panic("Failed to unwrap value");
            }
        };
    };

    when (T is not primitive)
    safe fn unwrap() -> loan T {
        match my {
            Ok(value) => return value,
            Err(err) => {
              panic("Failed to unwrap value");
            }
        };
    };

    when (T is not primitive)
    safe sink fn unwrap() -> T {
        match my {
            Ok(&&value) => return $value,
            Err(err) => {
              panic("Failed to unwrap value");
            }
        };
    };

    safe fn expectErr(const string msg) -> loan Error {
        match my {
            Ok(_) => {
              panic(msg.cstr());
            },
            Err(err) => return err
        };
    };

    safe sink fn expectErr(const string msg) -> Error {
        match my {
            Ok(_) => {
              panic(msg.cstr());
            },
            Err(&&err) => return $err
        };
    };

    safe fn unwrapErr() -> loan Error {
        match my {
            Ok(_) => {
              panic("Expected Err");
            },
            Err(err) => return err
        };
    };

    safe sink fn unwrapErr() -> Error {
        match my {
            Ok(_) => {
              panic("Expected Err");
            },
            Err(&&err) => return $err
        };
    };

    safe fn isOk() -> bool {
        match my {
            Ok() => return true,
            Err() => return false
        };
    };

    safe fn isErr() -> bool {
        match my {
            Ok() => return false,
            Err() => return true
        };
    };
    
    when(T is primitive)
    safe fn toString() -> string {
        match my {
            Ok(value) => return `Ok({value})`,
            Err(err) => return `Err({err})`
        }
    };

    when(T is not primitive and T has toString)
    safe fn toString() -> string {
        match my {
            Ok(value) => return `Ok({value})`,
            Err(err) => return `Err({err})`
        }
    };
    
    when(T is not primitive and T missing toString)
    safe fn toString() -> string {
        match my {
            Ok(value) => return `Ok({__typeName__})`,
            Err(err) => return `Err({err})`
        }
    };

    when (T is primitive)
    safe fn toOption() -> option::<T> {
        match my {
            Ok(value) => return new option::<T>->Some(value),
            Err() => return new option::<T>->None()
        }
    };

    when (T is not primitive)
    safe fn toOption() -> option::<T> {
        match my {
            Ok(value) => return new option::<T>->Some(value),
            Err() => return new option::<T>->None()
        }
    };
};

types(T)
// Convenience constructor for building an `Ok` from a value.
export fn accept(const T value) -> result::<T> {
    return new result::<T>->Ok(value);
};

types(T)
// Convenience constructor for building an `Err` from an Error.
export fn reject(const Error err) -> result::<T> {
    return new result::<T>->Err(err);
};

types(T)
/**
 * Wraps a move-only value when interfacing with APIs that expect `result<T>`
 * responses, defaulting to `Ok` semantics.
 */
when (T is not unique)
export fn resultWrapper(const T value) -> result::<T> {
    return new result::<T>->Ok(value);
};

types(T)
when (T is unique)
export fn resultWrapper(const T value) -> result::<T> {
    return new result::<T>->Ok(value);
};

types(T)
when (T is unique)
export fn resultWrapper(const T &&value) -> result::<T> {
    return new result::<T>->Ok($value);
};
