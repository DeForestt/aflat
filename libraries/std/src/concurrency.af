.needs <asm>
.needs <std>

import {len, int_toStringL0, str_toInt} from "strings" under str;
import Function from "Utils/Functions";
import {print} from "io" under io;

// Selects the isolation model used by a worker.
export enum WorkerMode {
    THREAD,
    PROCESS
};

// Represents the outcome from an asynchronous worker execution.
class AsyncOutput {
    bool okay;
    any data;

    AsyncOutput init(const bool okay, const any data) {
        my.okay = okay;
        my.data = data;
        return my;
    };
};

// Base thread abstraction exposing the PID getter.
class Thread {
    contract {
        private int pid;
    };
    int getPid();
};

// Simple fork/exec process wrapper.
class Process signs Thread {
    private adr foo;

    Process init(adr foo);
    int start(* adr args);
    bool isRunning();
};

// Bidirectional pipe wrapper exposing read/write operations.
class Pipe {
    int in;
    int out;
    int write(adr buf, int len);
    int read(adr buf, int len);
    Pipe init();
};

// Serialized message with helpers to write/read via Pipe.
class Message{
    int len;
    adr body;

    public Message init(adr body);
    public int writePipe(Pipe pipe);
    private Message copy<<=>>(Message msg);
};

// Managed process with inbox/outbox pipes for message passing.
class MProcess signs Thread {
    private adr foo;
    private Pipe inbox;
    private Pipe outbox;

    public MProcess init(adr foo);
    int start(* const any args);
    private Process copy<<=>>();
    public bool input(adr message);
    public adr output();
    public int kill(){
        sys_kill(my.pid, 2);
    };
};

class FD {
  public int out;
  public int in;
};

/**
 * Reference-counted handle used to await background processes or transform
 * their outputs.
 */
 types(T)
safe dynamic pedantic class AsyncResult {
    private MProcess p = NULL;
    private WorkerMode mode = WorkerMode.PROCESS;
    private adr thread = NULL;
    private int refcount = 0;
    private bool reaped = false;

    fn init(const WorkerMode mode, * const MProcess p, * const adr thread){
        my.mode = mode;
        my.p = p;
        my.thread = thread;
        return my;
    };
    
    fn get() -> Self {
	  	my.refcount = my.refcount + 1;
		  return my;
	  };

    void del() {
        if my.mode == WorkerMode.THREAD {
            af_worker_thread_release(my.thread);
            return;
        };
        if my.reaped == false {
            my.p.kill();
            const int pid = my.p.getPid();
            sys_wait(pid, NULL, 0, NULL);
            my.reaped = true;
        };
        const MProcess p = my.p;
        delete p;
    };

    public fn await() -> T {
        if my.mode == WorkerMode.THREAD {
            my.reaped = true;
            const generic result = af_worker_thread_await(my.thread);
            return result;
        };
        const generic result = my.p.output();
        if my.reaped == false {
            const int pid = my.p.getPid();
            sys_wait(pid, NULL, 0, NULL);
            my.reaped = true;
        };
        return result;
    };

    public bool isRunning() {
        if my.mode == WorkerMode.THREAD {
            return af_worker_thread_is_running(my.thread);
        };
        if my.reaped {
            return false;
        };
        const int pid = my.p.getPid();
        if sys_wait(pid, NULL, 1, NULL) == 0 {
            return true;
        };
        my.reaped = true;
        return false;
    };

    public adr then(const adr func, * const any arg1, * const any arg2, * const any arg3, * const any arg4) {
        if my.mode == WorkerMode.THREAD {
            const adr res = af_worker_thread_await(my.thread);
            my.reaped = true;
            return func(res, arg1, arg2, arg3, arg4);
        };
        const adr res = my.p.output();
        if my.reaped == false {
            const int pid = my.p.getPid();
            sys_wait(pid, NULL, 0, NULL);
            my.reaped = true;
        };
        return func(res, arg1, arg2, arg3, arg4);
    };

    public int kill() {
        if my.mode == WorkerMode.THREAD {
            return af_worker_thread_cancel(my.thread);
        };
        return my.p.kill();
    };

    public int timeout(const int time, *const int nano) {
        if my.mode == WorkerMode.THREAD {
            return af_worker_thread_timeout(my.thread, time, nano);
        };
        // create a new process that waits for time and then kills the process

        const Process timeout = Process(fn (const adr args) {
            const int[3] arg = args;
            sleep(arg[0], arg[1]);        
            if sys_kill(arg[2], 2) == 0 {
                io.print("timeout: killed process");
            };
            sys_exit(0);
        });
        const int[3] arg = {time, nano, my.p.getPid()};
        timeout.start(arg);
        return 0;
    };

    void endScope() {
        my.refcount = my.refcount - 1;
        if my.refcount == 0 {
            delete my;
        };
    };
};

// Helper struct bundling a function pointer and up to four arguments.
class WorkArgs {
    public adr func = bar;
    public adr arg1 = arg1;
    public adr arg2 = arg2;
    public adr arg3 = arg3;
    public adr arg4 = arg4;

    WorkArgs init(const adr bar, *const adr arg1, *const adr arg2, *const adr arg3, *const adr arg4){
        return my;
    };

    adr run() {
        const adr func = my.func;
        return func(my.arg1, my.arg2, my.arg3, my.arg4);
    };
};

Message init@Message(const adr body){
    my.len = blockSize(body);
    my.body = body;
};

Process init@Process(const adr bar){
    my.foo = bar;
    my.pid = 0;
};

MProcess init@MProcess(const adr bar){
    my.foo = bar;
    my.pid = 0;
    my.inbox = new Pipe();
    my.outbox = new Pipe();
};

int start@Process(const adr args){
    my.pid = sys_fork();
    const adr bar = my.foo;
    if(my.pid == 0){
        bar(args);
        sys_exit(0);
    };
    return 0;
};

int start@MProcess(const any args){
    my.pid = sys_fork();
    const adr bar = my.foo;
    if my.pid == 0 {
        bar(args, my.inbox, my.outbox);
        sys_exit(0);
    };
    return 0;
};

int getPid@Thread(){
    return my.pid;
};

bool isRunning@Process(){
    const int status = sys_kill(my.pid, 0); // 0 means no signal
    return status >= 0;
};



// Read a Message structure from the provided pipe.
export Message readPipe(const Pipe pipe){
    const byte[4] header;
    pipe.read(header, 4);
    const int mlen = header as int;
    // read body from pipe
    const adr mbody = af_malloc(mlen);

    pipe.read(mbody, mlen);
    const Message m = new Message(mbody);
    return m;
};

int writePipe@Message(const Pipe pipe){
    const int l = my.len;
    pipe.write(?l, 4);
    pipe.write(my.body, my.len);
    return 0;
};

bool input@MProcess(const adr message){
    const Message m = Message(message);
    const Pipe pipe = my.inbox;
    m.writePipe(pipe);
    return true;
};


adr output@MProcess(){
    const Pipe outbox = my.outbox;
    const Message m = readPipe(outbox);
    return m.body;
};

Pipe init@Pipe(){
    const FD fd = FD();
    sys_pipe(fd);
    my.out = fd.out;
    my.in = fd.in;
};

int read@Pipe(const adr buf, const int size){
    const int fd = my.out;
    const int ret = sys_read(fd, buf, size);
    return ret;
};

int write@Pipe(const adr buf, const int size){
    const int fd = my.in;
    const int ret = sys_write(fd, buf, size);
    return ret;
};

// Terminate the current process with the provided status code.
export int exit(const int status){
    sys_exit(status);
    return 0;
};

// Wait for the given thread/process to finish, returning its PID.
export int wait(const Thread p){
    sys_wait(p.getPid(), NULL, 0, NULL);
    return 0;
};

/**
 * Execute `foo` with up to four arguments using the requested worker mode.
 */
types(T)
export fn worker(const adr foo, *const WorkerMode mode, *const any arg1, *const any arg2, *const any arg3, *const any arg4) -> AsyncResult::<T> {
    if mode == WorkerMode.THREAD {
        const adr thread = af_worker_thread_create(foo, arg1, arg2, arg3, arg4);
        return new AsyncResult::<T>(mode, NULL, thread);
    };

    const WorkArgs pArgs = new WorkArgs(foo, arg1, arg2, arg3, arg4);
    const MProcess p = new MProcess(fn (const WorkArgs args, const Pipe __inbox, const Pipe outbox) {
        const adr res = args.run();
        const Message msg = new Message(res);
        msg.writePipe(outbox);
    });
    const AsyncResult::<T> ret = new AsyncResult::<T>(mode, p, NULL);
    p.start(pArgs);
    return ret; 
};

// Spawn and await a `Function` directly, returning its AsyncResult wrapper.
types(T)
export fn do(const Function foo) -> AsyncResult::<T> {
    return worker::<T>(foo, WorkerMode.THREAD);
};

/**
 * create a new TYPED shared object
 */

types(T)
export fn makeShared(* const any arg1, * const any arg2, * const any arg3, * const any arg4, * const any arg5, const any arg6) -> T {
    const T val = mmap(NULL, T, 1 | 2, 1 | 32, -1, 0);
    when (T has init)
    if true {
      const adr constructor = T.init;
      constructor(val, arg1, arg2, arg3, arg4);
    };

    return val;
};
